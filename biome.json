{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "root": true,
  "files": {
    "includes": [
      "src/**",
      "test/**",
      "fixtures/host/**",
      "!fixtures/host/browser/dist/**"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "formatter": {
    "lineWidth": 120,
    "indentStyle": "tab",
    "indentWidth": 2
  }
}
